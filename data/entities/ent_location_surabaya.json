  "facts": [
    {
      "text": "According to the National Development Planning Agency, Surabaya is one of the four main central cities of Indonesia, alongside Jakarta, Medan, and Makassar.",
      "source_url": "https://en.wikipedia.org/wiki/Surabaya",
      "source_type": "reference_work",
      "confidence_tier": "reported",
      "fact_id": "fct_001",
      "first_reported": "2026-08-02",
      "last_updated": "2026-08-02",
      "supersedes": null,
      "contradicted_by": null
    },
    {
      "text": "The city covers a land area of 335.93 km2, and had a population of 2,874,314 within its city limits at the 2020 census.",
      "source_url": "https://en.wikipedia.org/wiki/Surabaya",
      "source_type": "reference_work",
      "confidence_tier": "reported",
      "fact_id": "fct_002",
      "first_reported": "2026-08-02",
      "last_updated": "2026-08-02",
      "supersedes": null,
      "contradicted_by": null
    },
    {
      "text": "With 3,018,022 people living in the city as of mid 2024 \nand over 10 million in the extended Surabaya metropolitan area, according to the latest official estimate, Surabaya is the second-largest metropolitan area in Indonesia.",
      "source_url": "https://en.wikipedia.org/wiki/Surabaya",
      "source_type": "reference_work",
