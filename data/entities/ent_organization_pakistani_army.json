  "facts": [
    {
      "text": "As of the 2025 reforms, the Pakistan Army is commanded by the Chief of Defence Forces (CDF), a position held concurrently by the Chief of Army Staff (COAS), who is typically a four-star general.",
      "source_url": "https://en.wikipedia.org/wiki/Pakistan_Army",
      "source_type": "reference_work",
      "confidence_tier": "reported",
