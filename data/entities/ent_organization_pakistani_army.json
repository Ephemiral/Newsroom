      "supersedes": null,
      "contradicted_by": null
    },
    {
      "text": "The Army was officially established in August 1947 after the Partition of India.",
      "source_url": "https://en.wikipedia.org/wiki/Pakistan_Army",
      "source_type": "reference_work",
      "confidence_tier": "reported",
      "fact_id": "fct_002",
